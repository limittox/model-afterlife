# The application uses the Neon serverless driver through the local WebSocket proxy.
DATABASE_URL=postgresql://model_afterlife:model_afterlife@db:5432/model_afterlife_app

# Drizzle Kit connects directly to the same local PostgreSQL database.
MIGRATION_DATABASE_URL=postgresql://model_afterlife:model_afterlife@localhost:54329/model_afterlife_app
PUSH_DATABASE_URL=postgresql://model_afterlife:model_afterlife@localhost:54329/model_afterlife
DATABASE_PURPOSE=development

# Protocol is intentionally omitted; the Neon driver chooses ws:// or wss://.
NEON_WS_PROXY=localhost:54330/v1

# The only model-inference credential. Keep it server-only; tests use frozen fakes.
OPENROUTER_API_KEY=

# Required only when exercising Trigger.dev cloud tasks in Plan 02.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
