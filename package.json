{
	"name": "model-afterlife",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.15.1",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome lint src scripts tests drizzle.config.ts drizzle.push.config.ts next.config.ts vitest.config.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"db:up": "docker compose up -d db wsproxy",
		"db:push": "drizzle-kit push --config drizzle.push.config.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "node --env-file-if-exists=.env --experimental-strip-types scripts/seed-world.ts",
		"check:resident-admission": "node --env-file-if-exists=.env --experimental-strip-types scripts/check-resident-admission.ts",
		"eval:phase-02:frozen": "node --experimental-strip-types scripts/run-phase-02-evals.ts",
		"eval:phase-02:live": "node --env-file-if-exists=.env --experimental-strip-types scripts/run-phase-02-live.ts --live --samples=5 --reference-subset=3",
		"eval:phase-02:live:continue": "node --env-file-if-exists=.env --experimental-strip-types scripts/run-phase-02-live.ts --live --reference-only-continuation",
		"eval:phase-02:live:retry": "node --env-file-if-exists=.env --experimental-strip-types scripts/run-phase-02-live.ts --live --reference-only-retry",
		"privacy:phase-02": "node --experimental-strip-types scripts/scan-phase-02-privacy.ts",
		"verify:phase-02": "node --experimental-strip-types scripts/verify-phase-02.ts",
		"rebuild-world": "node --env-file-if-exists=.env --experimental-strip-types scripts/rebuild-world.ts",
		"trigger:dev": "trigger.dev dev"
	},
	"dependencies": {
		"@arizeai/phoenix-otel": "2.1.0",
		"@neondatabase/serverless": "1.1.0",
		"@openrouter/ai-sdk-provider": "3.0.0",
		"@tanstack/react-query": "5.101.4",
		"@trigger.dev/sdk": "4.5.6",
		"ai": "7.0.34",
		"bufferutil": "4.1.0",
		"drizzle-orm": "0.45.2",
		"next": "16.2.11",
		"phaser": "4.2.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"ws": "8.21.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@playwright/test": "1.61.1",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "24.13.3",
		"@types/pg": "8.20.0",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/ws": "8.18.1",
		"dotenv": "17.4.2",
		"drizzle-kit": "0.31.10",
		"fast-check": "4.9.0",
		"pg": "8.22.0",
		"promptfoo": "0.121.19",
		"tailwindcss": "4.3.3",
		"trigger.dev": "4.5.6",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	}
}
